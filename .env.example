# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore. Never commit real keys, tokens, or trigger
# URLs — any of them is enough to change flags in your LaunchDarkly project.


# ---------------------------------------------------------------------------
# REQUIRED — the server-side SDK key for the environment you want to demo in.
# ---------------------------------------------------------------------------
# LaunchDarkly UI: Project settings -> Environments -> the "..." menu on your
# environment (e.g. "Test") -> "SDK key" -> Copy.
#
# It must start with `sdk-`. A mobile key (`mob-`) or client-side ID will not
# work: this demo uses the server-side Python SDK.
LAUNCHDARKLY_SDK_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL — the flag this demo toggles.
# ---------------------------------------------------------------------------
# You must create a boolean flag with this key in the same project/environment.
# See README.md -> "Step 4: Create the feature flag". Only change this if you
# used a different key when creating the flag.
LD_FLAG_KEY=release-order-insights-v2


# ---------------------------------------------------------------------------
# OPTIONAL — remediation, i.e. the kill switch. Pick ONE of the two options.
# ---------------------------------------------------------------------------
# The demo runs fine without these; you just have to toggle the flag in the
# LaunchDarkly UI instead of from the app's "Emergency rollback" button or
# scripts/remediate.sh.

# Option A (preferred): a flag trigger URL.
# LaunchDarkly UI: open the flag -> Settings tab (or the "..." menu) ->
# Triggers -> "Add trigger" -> integration "Generic trigger",
# action "Turn off flag" -> Save -> copy the generated URL.
# Treat this URL as a secret: anyone who has it can turn your flag off.
LD_KILL_SWITCH_TRIGGER_URL=

# Option B (fallback, if triggers are not on your plan): the REST API.
# LaunchDarkly UI: Account settings -> Authorization -> Create token, with the
# built-in "Writer" role. Copy the token immediately — it is shown only once.
LD_API_TOKEN=
# The project and environment *keys* (the short URL-safe ones, not the display
# names). Find them under Project settings -> Environments.
LD_PROJECT_KEY=default
LD_ENVIRONMENT_KEY=test
# Only change this if you are on a LaunchDarkly federal or dedicated instance.
LD_API_BASE_URL=https://app.launchdarkly.com


# ---------------------------------------------------------------------------
# OPTIONAL — local web server settings.
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000


# ---------------------------------------------------------------------------
# OPTIONAL — offline self-test.
# ---------------------------------------------------------------------------
# Set to 1 to run the app with no LaunchDarkly account and no network: the flag
# is served from the SDK's in-memory TestData source and the page grows two
# buttons that toggle it. Useful for verifying your Python install before you
# have credentials. Leave it unset (or 0) for the real demo.
OFFLINE_SELF_TEST=0
