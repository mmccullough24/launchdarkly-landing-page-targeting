# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore. Never commit real keys or tokens — either one
# is enough to read or change flags in your LaunchDarkly project.


# ---------------------------------------------------------------------------
# REQUIRED — the server-side SDK key for the environment you want to demo in.
# ---------------------------------------------------------------------------
# LaunchDarkly UI: Project settings -> Environments -> the "..." menu on your
# environment (e.g. "Test") -> "SDK key" -> Copy.
#
# It must start with `sdk-`. A mobile key (`mob-`) or a client-side ID will not
# work: this demo uses the server-side Python SDK.
#
# No LaunchDarkly account yet? Skip this and run the app with OFFLINE_DEMO=1
# (see the bottom of this file).
LAUNCHDARKLY_SDK_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL — the flag this demo targets.
# ---------------------------------------------------------------------------
# You must create a STRING flag with this key and three variations
# (control / spotlight / conversion) in the same project and environment as the
# SDK key above. See README.md -> "Step 4". Only change this if you used a
# different key when you created the flag.
LD_FLAG_KEY=landing-page-hero


# ---------------------------------------------------------------------------
# OPTIONAL — LaunchDarkly REST API access.
# ---------------------------------------------------------------------------
# Only needed for `scripts/setup_launchdarkly.py`, which creates the flag,
# its individual target, and its targeting rule for you instead of you clicking
# through the UI. The app itself never uses these.
#
# LaunchDarkly UI: Account settings -> Authorization -> Create token, with the
# built-in "Writer" role. Copy it immediately — it is shown only once.
LD_API_TOKEN=

# The project and environment *keys* (the short URL-safe ones, not the display
# names). Find them under Project settings -> Environments.
LD_PROJECT_KEY=default
LD_ENVIRONMENT_KEY=test

# Only change this if you are on a LaunchDarkly federal or dedicated instance.
LD_API_BASE_URL=https://app.launchdarkly.com


# ---------------------------------------------------------------------------
# OPTIONAL — local web server settings.
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000


# ---------------------------------------------------------------------------
# OPTIONAL — offline demo mode.
# ---------------------------------------------------------------------------
# Set to 1 to run with no LaunchDarkly account and no network. The flag — with
# its individual target and its targeting rule already configured — is served
# from an in-process data source, and the SDK's real evaluation engine decides
# who gets what. Every targeting reason you see is genuine.
#
# Useful for verifying your Python setup before you have credentials, and for
# demoing on a plane. Leave it unset (or 0) to use your own account.
OFFLINE_DEMO=0
